# Copy to deploy/.env (ignored by git) and fill every value. On the VPS: chmod 600 .env
# Generate hex secrets with:  openssl rand -hex 32

# ---------------------------------------------------------------- domain and TLS
DOMAIN=luisjgl.cloud
ACME_EMAIL=you@example.com
# Start with staging to avoid Let's Encrypt rate limits; switch to production once HTTPS works:
#   https://acme-v02.api.letsencrypt.org/directory
# After switching, delete the staging certificates: docker volume rm puzzlelove_letsencrypt
ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Traefik dashboard (https://traefik.$DOMAIN) uses basic auth from deploy/traefik/users (ignored by git):
#   docker run --rm httpd:2.4-alpine htpasswd -nbB admin 'your-password' > deploy/traefik/users

# Images are chosen by deploy.sh (IMAGE_REPO + tag); do not set APP_IMAGE and friends here.

# ---------------------------------------------------------------- Postgres
# Hex only: it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=

# ---------------------------------------------------------------- Garage (S3)
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
# Access key must look like GK + 32 hex chars:  echo "GK$(openssl rand -hex 16)"
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- app
ADMIN_PASSWORD=
SESSION_SECRET=
# Live bots in the global room at peak hours (0 disables).
BOTS_MAX=2

# ---------------------------------------------------------------- analytics lake (Garage bucket `lake`)
# Separate key for the pipeline; deploy.sh imports it into Garage. Same format as S3_ACCESS_KEY_ID.
LAKE_ACCESS_KEY_ID=
LAKE_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- backups (Cloudflare R2)
# Bucket-scoped R2 API token (Object Read & Write). Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=puzzlelove-backups
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# age PUBLIC key (age1...). The private key stays off the server; it is only piped in for restores.
BACKUP_AGE_RECIPIENT=
# Optional: Uptime Kuma push monitor pinged after each successful backup (internal URL, token from the Kuma UI):
#   http://uptime-kuma:3001/api/push/<token>?status=up&msg=OK
BACKUP_PING_URL=
