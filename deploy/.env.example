# Copy to deploy/.env (ignored by git) and fill every value. On the VPS: chmod 600 .env
# Generate hex secrets with:  openssl rand -hex 32

# ---------------------------------------------------------------- domain and TLS
DOMAIN=luisjgl.cloud
ACME_EMAIL=you@example.com
# Start with staging to avoid Let's Encrypt rate limits; switch to production once HTTPS works:
#   https://acme-v02.api.letsencrypt.org/directory
# After switching, delete the staging certificates: docker volume rm puzzlelove_letsencrypt
ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Traefik dashboard (https://traefik.$DOMAIN) uses basic auth from deploy/traefik/users (ignored by git):
#   docker run --rm httpd:2.4-alpine htpasswd -nbB admin 'your-password' > deploy/traefik/users

# ---------------------------------------------------------------- images
# Built locally by docker-compose.local.yml; on the VPS they come from GHCR.
APP_IMAGE=puzzlelove:local
MIGRATE_IMAGE=puzzlelove-migrate:local

# ---------------------------------------------------------------- Postgres
# Hex only: it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=

# ---------------------------------------------------------------- Garage (S3)
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
# Access key must look like GK + 32 hex chars:  echo "GK$(openssl rand -hex 16)"
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- app
ADMIN_PASSWORD=
SESSION_SECRET=
