PORT=3001

# Local development with `npm run db:embedded` (no Docker needed).
# With `docker compose up`, use port 5432 instead.
DATABASE_URL=postgresql://puzzlelove:puzzlelove@localhost:5433/puzzlelove

# "local" stores images on disk. "s3" works with MinIO, Cloudflare R2 or AWS S3.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/uploads

# S3_ENDPOINT=http://localhost:9000
# S3_REGION=auto
# S3_BUCKET=puzzlelove
# S3_ACCESS_KEY_ID=puzzlelove
# S3_SECRET_ACCESS_KEY=puzzlelove-secret
# S3_FORCE_PATH_STYLE=true

# Admin page (/admin). Leave empty to disable admin login.
ADMIN_PASSWORD=change-me
SESSION_SECRET=replace-with-a-long-random-string

# Set to 1 when running behind a reverse proxy (Traefik on the VPS) so rate limits see real client IPs.
TRUST_PROXY=0
