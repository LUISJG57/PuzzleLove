generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Room {
  id             String   @id @default(cuid())
  slug           String   @unique
  isGlobal       Boolean  @default(false)
  imageKey       String
  imageWidth     Int
  imageHeight    Int
  rows           Int
  cols           Int
  seed           Int
  /// PuzzleState JSON: groups, scores, startedAt, completedAt
  state          Json
  createdAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())

  @@index([isGlobal, lastActivityAt])
}

model GlobalQueueItem {
  id          String    @id @default(cuid())
  imageKey    String
  imageWidth  Int
  imageHeight Int
  createdAt   DateTime  @default(now())
  usedAt      DateTime?

  @@index([usedAt, createdAt])
}

/// Append-only gameplay events for the analytics pipeline (see src/analytics).
/// `id` is the incremental extract watermark; `eventId` deduplicates downstream.
model AnalyticsEvent {
  id            BigInt   @id @default(autoincrement())
  eventId       String   @unique @map("event_id") @db.Uuid
  eventType     String   @map("event_type")
  schemaVersion Int      @map("schema_version") @db.SmallInt
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(3)
  ingestedAt    DateTime @default(now()) @map("ingested_at") @db.Timestamptz(3)
  sessionId     String?  @map("session_id")
  clientId      String?  @map("client_id")
  roomSlug      String?  @map("room_slug")
  roomType      String?  @map("room_type")
  puzzleId      String?  @map("puzzle_id")
  payload       Json
  /// True for history generated by tools/simulator backfill; live bots are real traffic with client_id "bot-...".
  isSynthetic   Boolean  @default(false) @map("is_synthetic")

  @@index([occurredAt])
  @@index([eventType, occurredAt])
  @@map("analytics_events")
}
